# Copy to .env and fill in. Never commit .env. Claude Code is not allowed to read .env.

# --- Mode ---
APP_MODE=live                 # live | replay
DISPLAY_ANONYMIZED=true       # hide real competitor brand names (video/screenshots)
SEED=42

# --- PayPal (SANDBOX ONLY) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# --- Channel3 ---
CHANNEL3_API_KEY=

# --- In-app LLM (Gemini free tier) ---
GEMINI_API_KEY=
LLM_MODEL=

# --- AG Grid / AG Studio (start trial Oct 31) ---
AG_LICENSE_KEY=

# --- Feature flags (cut list) ---
FEATURE_STUDIO_AGENT=true
FEATURE_AG_STUDIO=true
FEATURE_SHIPMENT_TRACKING=true
FEATURE_FEED_EXPORT=true
FEATURE_PICK_MODEL=true
